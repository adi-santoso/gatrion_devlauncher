{
  "name": "devlauncher",
  "productName": "DevLauncher",
  "version": "0.2.1",
  "description": "Desktop application to manage multiple development projects",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:main": "electron-vite build",
    "icons": "node scripts/generate-icons.js",
    "changelog": "node scripts/changelog.js",
    "changelog:apply": "node scripts/changelog.js --apply",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "typecheck": "tsc -p tsconfig.electron.json && tsc -p tsconfig.app.json",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "dev-tools",
    "project-manager"
  ],
  "author": "Gatrion Dev",
  "license": "MIT",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron-updater": "^6.8.9",
    "js-yaml": "^4.3.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.10"
  }
}
