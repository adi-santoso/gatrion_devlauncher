{
  "name": "devlauncher",
  "productName": "DevLauncher",
  "version": "1.0.0",
  "description": "Desktop application to manage multiple development projects",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:vite": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win --x64",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "dev-tools",
    "project-manager"
  ],
  "author": "Gatrion Dev",
  "license": "MIT",
  "dependencies": {
    "electron": "^43.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "wait-on": "^9.0.10"
  }
}
