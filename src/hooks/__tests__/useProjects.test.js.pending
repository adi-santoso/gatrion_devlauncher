import { describe, test, expect, vi, beforeEach } from 'vitest'
import { renderHook, act } from '@testing-library/react'
import { useProjects } from '../useProjects'

vi.mock('../../utils/ipcRenderer', () => ({
  isElectronAvailable: () => false,
  ipc: {
    invoke: vi.fn(),
    on: vi.fn(() => () => {}),
    removeAllListeners: vi.fn()
  },
  mockData: {
    projects: [],
    addProject: vi.fn(),
    updateProject: vi.fn(),
    deleteProject: vi.fn()
  }
}))

describe('useProjects', () => {
  beforeEach(() => {
    vi.clearAllMocks()
  })

  test('initializes with empty projects array', () => {
    const { result } = renderHook(() => useProjects())
    
    expect(result.current.projects).toEqual([])
    expect(result.current.loading).toBe(false)
  })

  test('loads projects from storage on mount', async () => {
    const mockProjects = [
      { id: '1', name: 'Test Project', path: '/test' },
      { id: '2', name: 'Another Project', path: '/another' }
    ]
    
    // Mock IPC response
    vi.mocked(window.electron?.ipcRenderer?.invoke).mockResolvedValue(mockProjects)
    
    const { result } = renderHook(() => useProjects())
    
    await new Promise(resolve => setTimeout(resolve, 0))
    
    expect(result.current.projects.length).toBeGreaterThan(0)
  })

  test('add project creates new entry', async () => {
    const mockNewProject = {
      id: 'new-uuid-123',
      name: 'New Project',
      path: '/new/path',
      type: 'CUSTOM'
    }
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockImplementation((channel, ...args) => {
        if (channel === 'project:add') return mockNewProject
        return null
      })
    
    const { result } = renderHook(() => useProjects())
    
    await act(async () => {
      await result.current.addProject({
        name: 'New Project',
        path: '/new/path',
        type: 'CUSTOM',
        startCommand: 'npm run dev'
      })
    })
    
    expect(result.current.projects).toContainEqual(expect.objectContaining({
      name: 'New Project',
      path: '/new/path'
    }))
  })

  test('delete project removes from list', async () => {
    const initialProjects = [
      { id: '1', name: 'To Delete', path: '/delete' }
    ]
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockImplementation((channel, ...args) => {
        if (channel === 'project:list') return initialProjects
        if (channel === 'project:delete') return true
        return null
      })
    
    const { result } = renderHook(() => useProjects())
    
    await new Promise(resolve => setTimeout(resolve, 0))
    
    expect(result.current.projects).toHaveLength(1)
    
    await act(async () => {
      await result.current.deleteProject('1')
    })
    
    expect(result.current.projects).toHaveLength(0)
  })

  test('update project modifies existing entry', async () => {
    const initialProject = {
      id: '1',
      name: 'Old Name',
      path: '/path',
      port: 3000
    }
    
    const updatedProject = {
      id: '1',
      name: 'Updated Name',
      path: '/path',
      port: 8080
    }
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockImplementation((channel, ...args) => {
        if (channel === 'project:list') return [initialProject]
        if (channel === 'project:update') return updatedProject
        return null
      })
    
    const { result } = renderHook(() => useProjects())
    
    await new Promise(resolve => setTimeout(resolve, 0))
    
    await act(async () => {
      await result.current.updateProject('1', {
        name: 'Updated Name',
        port: 8080
      })
    })
    
    expect(result.current.projects[0].name).toBe('Updated Name')
    expect(result.current.projects[0].port).toBe(8080)
  })

  test('handles error when adding invalid project', async () => {
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockRejectedValue(new Error('Invalid path'))
    
    const { result } = renderHook(() => useProjects())
    
    await act(async () => {
      try {
        await result.current.addProject({
          name: '',
          path: ''
        })
      } catch (e) {
        expect(e.message).toBe('Invalid path')
      }
    })
  })
})
