import { describe, test, expect, vi, beforeEach } from 'vitest'
import { renderHook, act } from '@testing-library/react'
import { useProcesses } from '../useProcesses'

vi.mock('../../utils/ipcRenderer', () => ({
  isElectronAvailable: () => false,
  ipc: {
    invoke: vi.fn(),
    on: vi.fn(() => () => {}),
    removeAllListeners: vi.fn()
  },
  mockData: {
    startProcess: vi.fn(),
    stopProcess: vi.fn(),
    restartProcess: vi.fn()
  }
}))

describe('useProcesses', () => {
  beforeEach(() => {
    vi.clearAllMocks()
  })

  test('initializes with empty states', () => {
    const { result } = renderHook(() => useProcesses())
    
    expect(result.current.processStatuses).toEqual({})
    expect(result.current.processLogs).toEqual({})
  })

  test('start process updates status to STARTING then RUNNING', async () => {
    const mockResponse = {
      success: true,
      pid: 12345,
      status: 'running'
    }
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockResolvedValue(mockResponse)
    
    const { result } = renderHook(() => useProcesses())
    
    await act(async () => {
      await result.current.startProcess('project-1', '/path', 'npm run dev', {}, 3000)
    })
    
    // Should have started
    expect(result.current.processStatuses['project-1']).toBe('running')
  })

  test('stop process updates status to STOPPING then STOPPED', async () => {
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockImplementation((channel, projectId) => {
        if (channel === 'process:start') return { success: true, pid: 123, status: 'running' }
        if (channel === 'process:stop') return true
        return null
      })
    
    const { result } = renderHook(() => useProcesses())
    
    // First start
    await act(async () => {
      await result.current.startProcess('project-1', '/path', 'npm run dev', {}, 3000)
    })
    
    expect(result.current.processStatuses['project-1']).toBe('running')
    
    // Then stop
    await act(async () => {
      await result.current.stopProcess('project-1')
    })
    
    expect(result.current.processStatuses['project-1']).toBe('stopped')
  })

  test('restart process stops and starts new instance', async () => {
    let callCount = 0
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockImplementation((channel, projectId) => {
        callCount++
        if (channel === 'process:restart') {
          return { success: true, pid: 123 + callCount, status: 'running' }
        }
        return null
      })
    
    const { result } = renderHook(() => useProcesses())
    
    await act(async () => {
      await result.current.restartProcess('project-1', '/path', 'npm run dev', {}, 3000)
    })
    
    expect(result.current.processStatuses['project-1']).toBe('running')
    expect(callCount).toBeGreaterThanOrEqual(1)
  })

  test('get metrics returns memory and uptime for running process', async () => {
    const mockMetrics = {
      status: 'running',
      pid: 12345,
      uptime: '5m 32s',
      uptimeSec: 332,
      memoryMb: 128,
      cpuPercent: 5.2
    }
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockResolvedValue(mockMetrics)
    
    const { result } = renderHook(() => useProcesses())
    
    await act(async () => {
      const metrics = await result.current.getProcessMetrics('project-1')
      expect(metrics.memoryMb).toBe(128)
      expect(metrics.uptime).toContain('m')
    })
  })

  test('handles error when starting non-existent project', async () => {
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockRejectedValue(new Error('Project not found'))
    
    const { result } = renderHook(() => useProcesses())
    
    await act(async () => {
      try {
        await result.current.startProcess('nonexistent', '/fake', 'fake command', {})
      } catch (e) {
        expect(e.message).toBe('Project not found')
      }
    })
  })

  test('clear logs removes log buffer for project', async () => {
    const mockLogs = [
      { id: 1, timestamp: '2026-07-31T10:00:00Z', type: 'stdout', message: 'Test log' }
    ]
    
    vi.mocked(window.electron?.ipcRenderer?.invoke)
      .mockImplementation((channel, projectId) => {
        if (channel === 'process:get-logs') return mockLogs
        if (channel === 'process:clear-logs') return true
        return null
      })
    
    const { result } = renderHook(() => useProcesses())
    
    // Get initial logs
    const initialLogs = await result.current.getProjectLogs('project-1')
    expect(initialLogs.length).toBe(1)
    
    // Clear logs
    await act(async () => {
      await result.current.clearProjectLogs('project-1')
    })
    
    const afterClearLogs = await result.current.getProjectLogs('project-1')
    expect(afterClearLogs.length).toBe(0)
  })
})
