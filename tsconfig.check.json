{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node10",
    "lib": ["ES2022", "DOM"],
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "electron": ["./node_modules/electron/electron.d.ts"]
    }
  },
  "include": [
    "electron/**/*.js",
    "src/utils/prayerTimes.js"
  ],
  "exclude": ["electron/**/__tests__/**"]
}
